# LLM Provider Key Pool (comma-separated, at least 2 keys)
LLM_API_KEYS=key_1_placeholder,key_2_placeholder

# Optional Direct Provider Keys
OPENAI_API_KEY=your_nvidia_or_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# SQLite Database Storage Location (e.g. sqlite:////data/app.db or sqlite:///./data/app.db)
DATABASE_URL=sqlite:////data/app.db

# CORS Allowed Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Failover Simulation Switch (must be true to honor X-Simulate-Failure header)
ENABLE_FAILURE_SIMULATION=true

# Configurable LLM Provider Models & Endpoints
PRIMARY_MODEL_NAME=openai/nvidia/nemotron-3.5-lightning-30b-a3b
PRIMARY_API_BASE=https://integrate.api.nvidia.com/v1
FALLBACK_MODEL_NAME=gemini/gemini-3.5-flash-lite

# Frontend API Base URL for Vite Client (defaults to http://localhost:8000)
VITE_API_URL=http://localhost:8000
